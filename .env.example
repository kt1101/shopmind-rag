# ShopMind environment variables.
# Copy to .env (`cp .env.example .env`) and fill in secrets. Never commit .env.
# docker compose reads this file for variable substitution and passes it to the
# `api` / `tools` containers; values hard-wired in docker-compose.yml
# (ELASTICSEARCH_URL, DATABASE_URL, PRODUCT_IMAGE_DIR) win inside containers.

# --- Runtime profile -------------------------------------------------------
# Config layering: configs/app.yaml (+ include files) -> configs/profiles/<profile>.yaml
#   -> environment (SHOPMIND__...) -> runtime overrides saved from /admin.
# One of: dev | demo | eval. docker compose defaults to demo.
SHOPMIND_PROFILE=demo
# Optional: load an explicit config file instead of the default (legacy single-file mode).
# SHOPMIND_CONFIG=configs/app.yaml

# --- Elasticsearch (search store) -----------------------------------------
# Used by host-side scripts and tests; containers always use http://elasticsearch:9200.
ELASTICSEARCH_URL=http://localhost:9200
# Leave empty for the local single-node cluster (security disabled).
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- PostgreSQL (system of record) ----------------------------------------
# The postgres container is created with these credentials on first start
# (changing them later requires `docker compose down -v` or a manual ALTER USER).
POSTGRES_USER=shopmind
POSTGRES_PASSWORD=shopmind
POSTGRES_DB=shopmind
# Host port published for host-side tools (psql, alembic, tests).
POSTGRES_PORT=5432
# SQLAlchemy URL for host-side runs (alembic, scripts). Inside docker compose the api
# gets postgresql+psycopg://...@postgres:5432/<POSTGRES_DB> automatically.
DATABASE_URL=postgresql+psycopg://shopmind:shopmind@localhost:5432/shopmind

# --- Admin authentication (JWT) -------------------------------------------
# Signs admin/debug JWTs. Use a long random value outside local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-please-32-chars-min
# Bootstrap admin account created by `make seed` (scripts.seed_demo) if missing.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Models ----------------------------------------------------------------
# Hugging Face token, only needed if a configured model is gated.
HF_TOKEN=

# --- LLM providers ---------------------------------------------------------
# Enables RAG answers / chat. Without it, search keeps working and chat returns 503 llm_unavailable.
OPENAI_API_KEY=
# Overrides rag.llm.model from config (default gpt-5.4-mini).
# OPENAI_MODEL=gpt-5.4-mini
# Local LLM (docker compose --profile llm-local up -d ollama). Host runs use localhost.
# OLLAMA_BASE_URL=http://localhost:11434

# --- Cache (optional) ------------------------------------------------------
# Empty = in-process cache. With `docker compose --profile cache up -d redis`:
# REDIS_URL=redis://redis:6379/0
REDIS_URL=

# --- HTTP ------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS; empty disables CORS.
CORS_ORIGINS=

# --- Docker build ----------------------------------------------------------
# Optional dependency groups (api/pyproject.toml extras) baked into the api image.
# API_EXTRAS=text-embed,rag-rerank,viz

# --- Nested config overrides (SHOPMIND__...) ------------------------------
# Any key of the YAML config can be overridden with pydantic-settings using the
# SHOPMIND__ prefix and `__` as the nesting delimiter (keys are case-insensitive).
# Unknown keys are rejected (config models use extra="forbid").
# Examples:
# SHOPMIND__RAG__LLM__MODEL=gpt-5.4-mini          # rag.llm.model
# SHOPMIND__RETRIEVAL__DEFAULT_MODE=bm25          # retrieval.default_mode
